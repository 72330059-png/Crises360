<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include shared preferences (e.g., language settings, user profile) -->
        <include domain="sharedpref" path="."/>
        <!-- Exclude specific sensitive files if necessary -->
        <!-- <exclude domain="sharedpref" path="device_token.xml"/> -->
    </cloud-backup>
    <device-transfer>
        <!-- Transfer everything to the new phone -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
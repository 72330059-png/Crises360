<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sosMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FB">

    <!-- TOP HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical"
        android:background="#C62828">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 SOS EMERGENCY"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send emergency request instantly"
            android:textSize="14sp"
            android:textColor="#FFECEC"/>
    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency Type"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/sosTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@android:drawable/editbox_background"
                android:padding="10dp"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Describe your situation"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/sosMessage"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:hint="Write what happened..."
                android:gravity="top"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#000000"
                android:textColorHint="#888888"/>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#E8F1FF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Auto Location"
                        android:textStyle="bold"
                        android:textColor="#1E3A5F"/>

                    <TextView
                        android:id="@+id/locationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fetching your location..."
                        android:textColor="#5B7A99"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <Button
                android:id="@+id/btnSendSOS"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:text="SEND EMERGENCY"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C62828"/>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
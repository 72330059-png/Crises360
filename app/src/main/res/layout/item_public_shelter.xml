<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/shelterCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="4dp"
        card_view:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ── Row 1: Status pill + Distance ─────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPEN"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/pill_green" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/shelterDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A5F"
                    android:background="@drawable/badge_blue_outline"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Row 2: Letter icon + Name + Location ──────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/shelter_icon_letter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/circle_green"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/recommendedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Recommended"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#B45309"
                        android:background="@drawable/badge_amber"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/shelter_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1E2A38" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="3dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#607D8B"
                            android:layout_marginStart="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── Divider ────────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginBottom="10dp" />

            <!-- ── Capacity row ───────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Capacity" android:textColor="#94A3B8" android:textSize="11sp" />
                    <TextView android:id="@+id/capacityTotal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textStyle="bold" android:textSize="22sp" android:textColor="#1E2A38" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="#E2E8F0" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Available" android:textColor="#22C55E" android:textSize="11sp" />
                    <TextView android:id="@+id/capacityAvailable" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textStyle="bold" android:textSize="22sp" android:textColor="#22C55E" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="#E2E8F0" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Occupied" android:textColor="#EF4444" android:textSize="11sp" />
                    <TextView android:id="@+id/capacityOccupied" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textStyle="bold" android:textSize="22sp" android:textColor="#EF4444" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Progress bar ───────────────────────────────────────── -->
            <ProgressBar
                android:id="@+id/occupancyBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progressBackgroundTint="#F1F5F9"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/occupancyPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="0% occupied"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#22C55E" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
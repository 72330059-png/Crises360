<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Severity color strip -->
        <View
            android:id="@+id/priorityStrip"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="#EF4444" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top row: badge + time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/txtType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 Danger"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#EF4444"
                    android:background="@drawable/badge_danger_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txtTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 min ago"
                    android:textSize="11sp"
                    android:textColor="#98A2B3" />
            </LinearLayout>

            <!-- Message -->
            <TextView
                android:id="@+id/txtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explosion reported in Beirut. Stay away from the area."
                android:textSize="14sp"
                android:textColor="#1D2A44"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="10dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.8dp"
                android:background="#F2F4F7"
                android:layout_marginBottom="10dp" />

            <!-- Location -->
            <TextView
                android:id="@+id/txtLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Beirut"
                android:textSize="12sp"
                android:textColor="#667085" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
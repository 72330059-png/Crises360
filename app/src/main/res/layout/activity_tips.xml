<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F4FD">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛟 Safety Tips"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#27374D"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay prepared. Stay safe."
            android:textSize="14sp"
            android:textColor="#526D82"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_below="@id/header"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 🚨 GENERAL EMERGENCY -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨 General Emergency"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#27374D"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#526D82"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:text="Stay calm and think clearly. Panic can lead to poor decisions and increase danger.

Always follow instructions from official authorities such as civil defense or emergency services. Do not rely on rumors or unverified social media information.

Keep your mobile phone fully charged at all times and carry a power bank if possible.

Prepare an emergency plan with your family and agree on safe meeting points.

Keep important documents like ID and medical info in a safe and accessible place."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 💣 WAR SAFETY -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💣 War Safety"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#27374D"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#526D82"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:text="Stay away from windows and glass areas during attacks, as explosions can cause dangerous debris.

Move immediately to shelters, basements, or interior rooms without windows.

Avoid crowded places and main roads as they may be targeted.

Prepare an emergency bag with water, food, flashlight, and important documents.

If you hear explosions, lie flat and protect your head until it is safe.

Stay informed using trusted news and official updates."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 🌍 NATURAL DISASTERS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌍 Natural Disasters"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#27374D"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#526D82"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:text="For earthquakes: Drop, cover, and hold under a strong table away from windows.

For floods: Move to higher ground immediately and avoid walking through water.

For fires: Exit quickly using stairs, and stay low to avoid smoke.

For storms: Stay indoors and away from windows.

Always understand the risks in your area and prepare ahead."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 🧰 SURVIVAL KIT -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧰 Survival Kit"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#27374D"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#526D82"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:text="Prepare a kit that lasts at least 72 hours.

Include drinking water, non-perishable food, flashlight, batteries, and a first aid kit.

Keep important documents and some cash available.

Add a phone charger, radio, and necessary medications.

Adjust your kit based on weather and personal needs."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Bell icon -->
        <ImageView
            android:id="@+id/notifIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/circle_grey_bg"
            android:padding="6dp"
            android:src="@drawable/ic_bell"
            app:tint="#667085" />

        <!-- Unread dot -->
        <View
            android:id="@+id/dotUnread"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/badge_red_circle"
            android:visibility="gone" />

        <!-- Time -->
        <TextView
            android:id="@+id/tvNotifTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:textColor="#98A2B3"
            android:textSize="11sp" />

        <!-- Text content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/notifIcon"
            android:layout_toStartOf="@id/tvNotifTime"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <!-- Section badge -->
            <TextView
                android:id="@+id/tvNotifSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/badge_blue_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvNotifTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D2A44"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvNotifSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#98A2B3"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
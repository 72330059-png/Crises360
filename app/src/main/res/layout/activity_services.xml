<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2FB">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Emergency Services"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick access to emergency support"
                android:textSize="14sp"
                android:textColor="#5B7A99"
                android:layout_marginBottom="20dp"/>

            <!-- 🚨 SOS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSOS"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFE6E6">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:text="🚨 SOS"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#C62828"/>
            </androidx.cardview.widget.CardView>

            <!-- 🏥 Hospitals -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardHospitals"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#E6F0FF">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:text="🏥 Hospitals"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A5F"/>
            </androidx.cardview.widget.CardView>

            <!-- 🏠 Shelters (UPDATED EXPANDABLE) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardShelters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#E6FFF3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Main Title -->
                    <TextView
                        android:id="@+id/shelterTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏠 Shelters"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1E3A5F"/>

                    <!-- Hidden Options -->
                    <LinearLayout
                        android:id="@+id/shelterOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/optionHouses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🏠 Houses"
                            android:textSize="16sp"
                            android:padding="10dp"
                            android:textColor="#1E3A5F"
                            android:background="?attr/selectableItemBackground"/>

                        <TextView
                            android:id="@+id/optionPublicShelters"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🏫 Public Shelters"
                            android:textSize="16sp"
                            android:padding="10dp"
                            android:textColor="#1E3A5F"
                            android:background="?attr/selectableItemBackground"/>

                        <!-- Subtitle -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Schools • Universities • Institutions"
                            android:textSize="12sp"
                            android:textColor="#5B7A99"
                            android:paddingStart="10dp"
                            android:paddingBottom="8dp"/>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 📢 Needs & Requests -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNeeds"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFF4E6">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:text="📢 Needs &amp; Requests"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A5F"/>
            </androidx.cardview.widget.CardView>

            <!-- ⚡ Quick Emergency -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnQuickCall"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#DCEBFF">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:text="⚡ Quick Emergency Call"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A5F"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="-2dp"
        android:background="#FFFFFF"
        app:itemIconTint="#1E3A5F"
        app:itemTextColor="#1E3A5F"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".StartingActivity">

    <!-- TOP IMAGE -->
    <FrameLayout
        android:id="@+id/illustrationContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#E8F1FA"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivRespondersIllustration"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/main"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Main illustration" />

    </FrameLayout>

    <!-- BRAND -->

    <!-- BOTTOM -->
    <LinearLayout
        android:id="@+id/llBranding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/illustrationContainer">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBrandCrisis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="CRISIS"
                android:textColor="#1976D2"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBrand360"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="360"
                android:textColor="#FFA726"
                android:textSize="38sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Disaster Management &amp; Emergency System"
            android:textColor="#555555"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/llBranding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvMissionTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your safety. Our mission."
            android:textColor="#1976D2"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <Button
            android:id="@+id/btnlogin"
            android:layout_width="332dp"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1976D2"
            android:fontFamily="sans-serif-medium"
            android:text="Login"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSign"
            android:layout_width="338dp"
            android:layout_height="59dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1976D2"
            android:fontFamily="sans-serif-medium"
            android:text="Sign Up"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
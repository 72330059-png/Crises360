<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F0FF">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#6C47FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Self-Help Tools"
            android:textColor="#1A1A2E"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Intro label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Tools to help you cope during crisis"
                android:textColor="#7C3AED"
                android:textSize="13sp"
                android:textStyle="italic" />

            <!-- ══════════════════════════════════════════════ -->
            <!-- CARD 1 : 4-7-8 Breathing -->
            <!-- ══════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBreathing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_blue_bg">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:contentDescription="Breathing"
                                android:src="@drawable/ic_air"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4-7-8 Breathing"
                                android:textColor="#1A1A2E"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Calm your nervous system instantly"
                                android:textColor="#888888"
                                android:textSize="12sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="5 min • Proven for panic &amp; shock"
                                android:textColor="#3B82F6"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Animated breathing circle -->
                    <FrameLayout
                        android:id="@+id/breathingCircle"
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/breathing_circle_bg"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvBreathingInstruction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Inhale"
                                android:textColor="#6C47FF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBreathingCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4"
                                android:textColor="#6C47FF"
                                android:textSize="32sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <Button
                        android:id="@+id/btnStartBreathing"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/btn_purple_bg"
                        android:text="Start Exercise"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════ -->
            <!-- CARD 2 : Crisis Coping Techniques -->
            <!-- ══════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCoping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_green_bg">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:contentDescription="Coping"
                                android:src="@drawable/ic_grounding"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Crisis Coping Techniques"
                                android:textColor="#1A1A2E"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Evidence-based strategies for war &amp; disaster"
                                android:textColor="#888888"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/arrowCoping"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Expand"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#AAAAAA" />
                    </LinearLayout>

                    <!-- Expandable techniques list -->
                    <LinearLayout
                        android:id="@+id/layoutCopingSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="🧠  Name what you feel — Fear and grief are normal responses. Naming them reduces their power."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="🔒  Find a safe anchor — Identify one safe physical spot. Even a corner of a room helps regulate your nervous system."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="🤝  Stay connected — Isolation worsens trauma. Stay near people you trust, even silently."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="📵  Limit news exposure — Constant updates increase anxiety. Set 1-2 fixed times per day to check news."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="🕯️  Maintain a small routine — Eating, sleeping, and one daily task rebuild a sense of control."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="💬  Talk about it — Sharing your experience with a trusted person or counselor is one of the most powerful healers."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnShowCoping"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/btn_green_bg"
                        android:text="Show Techniques"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════ -->
            <!-- CARD 3 : PTSD Awareness -->
            <!-- ══════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPTSD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_orange_bg">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:contentDescription="PTSD"
                                android:src="@drawable/ic_journal"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Understanding Trauma Reactions"
                                android:textColor="#1A1A2E"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Know what is normal after a crisis"
                                android:textColor="#888888"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/arrowPTSD"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Expand"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#AAAAAA" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutPTSDSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="⚡  Shock &amp; numbness — Feeling detached or unable to feel is a protective response. It is temporary and normal."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="😰  Flashbacks &amp; nightmares — Intrusive memories are the brain processing trauma. They reduce over time with support."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="😤  Anger &amp; irritability — Heightened stress responses can feel like rage. This is your nervous system on high alert."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="😔  Grief &amp; sadness — Loss during war is profound. Allowing yourself to grieve is essential, not weakness."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="✅  When to seek help — If symptoms last more than 4 weeks or prevent daily functioning, speak to a counselor immediately."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnShowPTSD"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/btn_orange_bg"
                        android:text="Learn More"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════ -->
            <!-- CARD 4 : Helping Children in Crisis -->
            <!-- ══════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardChildren"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_purple_bg">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:contentDescription="Children"
                                android:src="@drawable/ic_chat_dots"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Helping Children Cope"
                                android:textColor="#1A1A2E"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Protect young ones during war &amp; disaster"
                                android:textColor="#888888"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/arrowChildren"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Expand"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#AAAAAA" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutChildrenSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="🗣️  Be honest in simple words — Children sense fear. Tell them what is happening at their level without details that overwhelm."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="🫂  Stay physically close — Your calm presence is the most powerful comfort a child can have."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="🎨  Encourage expression — Let them draw, play, or talk. Children process trauma through creative outlets."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/step_bg"
                            android:padding="12dp"
                            android:text="🚩  Warning signs — Persistent bedwetting, regression, refusal to eat, or extreme withdrawal need professional attention."
                            android:textColor="#1A1A2E"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnShowChildren"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/btn_purple_bg"
                        android:text="Show Guidance"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
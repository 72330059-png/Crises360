<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F0FF">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#6C47FF"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Self-Help Tools"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Breathing Exercise -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBreathing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_blue_bg">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_air"
                                app:tint="#FFFFFF"
                                android:contentDescription="Breathing" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4-7-8 Breathing"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Calm your nervous system"
                                android:textSize="12sp"
                                android:textColor="#888888"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5 min • Beginner"
                                android:textSize="11sp"
                                android:textColor="#6C47FF"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Breathing animation circle -->
                    <FrameLayout
                        android:id="@+id/breathingCircle"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/breathing_circle_bg"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvBreathingInstruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Inhale"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#6C47FF" />

                        <TextView
                            android:id="@+id/tvBreathingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="30dp"
                            android:text="4"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#6C47FF" />
                    </FrameLayout>

                    <Button
                        android:id="@+id/btnStartBreathing"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/btn_purple_bg"
                        android:text="Start Exercise"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Body Scan / Grounding -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGrounding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_green_bg">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_grounding"
                                app:tint="#FFFFFF"
                                android:contentDescription="Grounding" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5-4-3-2-1 Grounding"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reduce anxiety attacks"
                                android:textSize="12sp"
                                android:textColor="#888888"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="7 min • Any level"
                                android:textSize="11sp"
                                android:textColor="#22C55E"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Steps -->
                    <LinearLayout
                        android:id="@+id/layoutGroundingSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp"
                        android:visibility="gone">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:background="@drawable/step_bg" android:padding="12dp"
                            android:text="👁 5 things you can SEE"
                            android:textSize="13sp" android:textColor="#1A1A2E" android:layout_marginBottom="6dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:background="@drawable/step_bg" android:padding="12dp"
                            android:text="✋ 4 things you can TOUCH"
                            android:textSize="13sp" android:textColor="#1A1A2E" android:layout_marginBottom="6dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:background="@drawable/step_bg" android:padding="12dp"
                            android:text="👂 3 things you can HEAR"
                            android:textSize="13sp" android:textColor="#1A1A2E" android:layout_marginBottom="6dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:background="@drawable/step_bg" android:padding="12dp"
                            android:text="👃 2 things you can SMELL"
                            android:textSize="13sp" android:textColor="#1A1A2E" android:layout_marginBottom="6dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:background="@drawable/step_bg" android:padding="12dp"
                            android:text="👅 1 thing you can TASTE"
                            android:textSize="13sp" android:textColor="#1A1A2E" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnStartGrounding"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/btn_green_bg"
                        android:text="Start Exercise"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Mood Journal -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardJournal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_orange_bg">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_journal"
                                app:tint="#FFFFFF"
                                android:contentDescription="Journal" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mood Journal"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Track your emotions daily"
                                android:textSize="12sp"
                                android:textColor="#888888"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Mood selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="14dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/mood1" android:text="😢" android:textSize="28sp" android:layout_marginEnd="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Very sad"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/mood2" android:text="😕" android:textSize="28sp" android:layout_marginEnd="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Sad"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/mood3" android:text="😐" android:textSize="28sp" android:layout_marginEnd="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Neutral"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/mood4" android:text="🙂" android:textSize="28sp" android:layout_marginEnd="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Happy"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/mood5" android:text="😄" android:textSize="28sp" android:clickable="true" android:focusable="true" android:contentDescription="Very happy"/>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etJournalEntry"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="@drawable/input_bg"
                        android:hint="Write how you feel today..."
                        android:textColorHint="#BBBBBB"
                        android:textColor="#1A1A2E"
                        android:textSize="13sp"
                        android:padding="12dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:layout_marginTop="12dp" />

                    <Button
                        android:id="@+id/btnSaveJournal"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_orange_bg"
                        android:text="Save Entry"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>